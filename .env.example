# ─────────────────────────────────────────────────────────
#  Tech School QR Attendance System — Environment Config
#  Copy this file to .env and fill in production values
# ─────────────────────────────────────────────────────────

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=ChangeThisPassword123!

# JWT  (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRY_MS=86400000

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# School network restriction
SCHOOL_WIFI_SSID=TechSchool-WiFi
SCHOOL_IP_RANGE=192.168.1.0/24

# Attendance time windows (24h format, Africa/Lagos timezone)
QR_WINDOW_START=07:00
QR_WINDOW_END=08:30
LATE_THRESHOLD=07:30

# Seed demo data on first boot (set to false in production)
SEED_DATA=true

# Frontend
VITE_API_BASE_URL=/api
APP_FRONTEND_URL=http://localhost:5173

# Brevo SMTP Mail Service
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=your-brevo-smtp-username
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=QRAttendance
